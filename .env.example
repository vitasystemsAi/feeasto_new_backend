# Copy to .env and fill in values.

# Behind nginx/ALB (production): keep 1 so rate-limit trusts X-Forwarded-For
TRUST_PROXY=1

# --- Email (OTP) — REQUIRED for email OTP. GoDaddy / any SMTP ---
# Without SMTP_USER + SMTP_PASS + SMTP_FROM_EMAIL, registration OTP email will fail.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Feeasto

# --- SMS (mobile OTP in India) — configure ONE provider ---
# No provider is 100% free forever; these give free trial/test credits on signup:
#
# 2Factor.in (recommended to start — free test credits, no card)
#   1. Sign up: https://2factor.in
#   2. OTP Services → Manage OTP Templates → create template name FEAOTP
#      Body example: Your Feeasto verification code is {#var#}. Valid 5 min. Do not share.
#   3. Paste API key from dashboard:
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=FEAOTP
# SMS_PROVIDER=2factor

# TextLocal (free trial credits): https://www.textlocal.in → API key
# TEXTLOCAL_API_KEY=
# TEXTLOCAL_SENDER=TXTLCL

# Fast2SMS (wallet credits on signup): https://www.fast2sms.com
# FAST2SMS_API_KEY=

# MSG91 (trial credits): https://msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=FEASTR
# Optional: MSG91_OTP_MESSAGE=Your Feeasto code is ##OTP##. Valid ##MIN## min.

# Twilio (trial USD credit, not India-optimized)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Custom webhook: POST JSON { phone, message, otp }
# SMS_WEBHOOK_URL=

# Prefer one: 2factor | textlocal | fast2sms | msg91 | twilio
# SMS_PROVIDER=2factor

# India maps (optional)
MAPPLS_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
